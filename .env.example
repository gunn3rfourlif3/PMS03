# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
# DATABASE_URL: owner/superuser role — used by migrations + seed (DDL, bypasses RLS).
DATABASE_URL=postgres://pms:pms@localhost:5433/pms
# APP_DATABASE_URL: least-privileged app role — used by the running app so RLS is
# enforced. Falls back to DATABASE_URL if unset.
APP_DATABASE_URL=postgres://pms_app:pms_app@localhost:5433/pms
DB_SSL=false

# --- Redis (cache + BullMQ job queue) ---
REDIS_URL=redis://localhost:6380

# --- Object storage (S3-compatible: Cloudflare R2 / Hetzner) ---
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=pms-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
LOCAL_STORAGE_BASE=http://localhost:3000/dev-storage

# --- E-signature ---
ESIGN_DRIVER=native
ESIGN_BASE=http://localhost:3000/sign

# --- Payments (ZA). Active provider selected per-market. ---
# Collection rail (money-in): ikhokha | paystack | payfast | yoco | peach | stitch
# First deploy: iKhokha is the only live rail; the others stay stubbed unless you
# set their *_LIVE flag (e.g. PAYFAST_LIVE=true) AND their credentials.
PAYMENT_PROVIDER=ikhokha
# Payout rail (money-out to owners): paystack | stitch
PAYOUT_PROVIDER=paystack

# --- iKhokha (live collection rail) ---
IKHOKHA_APP_ID=
IKHOKHA_APP_SECRET=
IKHOKHA_ENTITY_ID=
IKHOKHA_BASE=https://api.ikhokha.com
IKHOKHA_PAYMENT_PATH=/public-api/v1/api/payment
IKHOKHA_MODE=live
IKHOKHA_VERIFY_CALLBACK=false   # set true once the inbound IK-SIGN scheme is confirmed          # 'live' | 'test' (only live works currently)
IKHOKHA_REQUESTER_URL=      # your site URL (defaults to the success URL)
IKHOKHA_CALLBACK_URL=
IKHOKHA_SUCCESS_URL=
IKHOKHA_FAIL_URL=
IKHOKHA_CANCEL_URL=
# Other rails are stubbed unless you flip these on:
# PAYFAST_LIVE=true   YOCO_LIVE=true   PEACH_LIVE=true   PAYSTACK_LIVE=true

# --- Stitch (pay-by-bank: instant EFT, Capitec Pay, Absa Pay, PayShap RTP) ---
# One payment request surfaces every method enabled on the client, so there is
# no per-method config. Token + GraphQL URLs are the same for test and live
# clients; which one you get is decided by the credentials.
STITCH_LIVE=false            # arming switch — credentials alone do nothing
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# Must be on a domain Stitch has allowlisted, and https in production.
STITCH_REDIRECT_URI=
STITCH_EXPIRY_HOURS=24       # payment request auto-expires after this
STITCH_PAYER_REF_PREFIX=RENT # ≤6 chars; leads the reference on the TENANT's bank statement
# Route settlement to a per-agency merchant pre-registered with Stitch, keyed by
# our vendor id (see docs/LOCARE_DEBIT_ORDER_DESIGN.md §7 — each agency is its
# own merchant). Leave false until merchants are actually provisioned, or every
# payment fails with BAD_USER_INPUT.
STITCH_EXTERNAL_MERCHANT_ID_FROM_VENDOR=false
# Svix signing secret for the webhook subscription (starts whsec_). This is the
# ONLY thing that can mark a Stitch payment paid — the browser redirect's status
# is a query parameter and is not trusted. Unset, webhooks are refused with 401.
STITCH_WEBHOOK_SECRET=
# received (default) — mark paid only once funds land in the Stitch intermediary
#                      account (payment.confirmation / PaymentReceived).
# completed          — mark paid when the payer finishes at their bank. Required
#                      if you settle directly to the agency and therefore never
#                      receive payment.confirmation, but it accepts settlement
#                      risk: the ledger is immutable, so a reversal is a new
#                      posting, not an edit.
STITCH_CONFIRM_ON=received
# Owner payouts via Stitch Disbursements. ZA-only and requires a funded FLOAT
# account with Stitch — an under-funded float parks the payout as
# DisbursementPaused for 7 days, then errors. Also set PAYOUT_PROVIDER=stitch.
# INSTANT clears immediately at extra cost; DEFAULT clears same-day.
STITCH_INSTANT_PAYOUTS=false
# Refunds are debited from the Stitch intermediary float, and Stitch only
# processes one once the ORIGINAL payment has cleared — so a refund issued
# straight after a payment can take ~3 days to clear in, then ~3 days out.
STITCH_INSTANT_REFUNDS=false
# DebiCheck mandate lifecycle (payment-consent-request events). Optional — if
# one Svix endpoint covers both payments and consents, leave this blank and
# STITCH_WEBHOOK_SECRET is used. Set it when consents have their own endpoint,
# because Svix signing secrets are per-subscription.
STITCH_CONSENT_WEBHOOK_SECRET=

# --- PayFast (redirect + ITN; PAYFAST_SANDBOX=false for live) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
PAYFAST_NOTIFY_URL=
# --- Yoco (Checkout API) ---
YOCO_SECRET_KEY=
YOCO_SUCCESS_URL=
YOCO_CANCEL_URL=
YOCO_FAILURE_URL=
YOCO_WEBHOOK_SECRET=
# --- Peach Payments (hosted checkout; endpoint/token are environment-specific) ---
PEACH_CHECKOUT_URL=
PEACH_BEARER_TOKEN=
PEACH_ENTITY_ID=
PEACH_RESULT_URL=
PEACH_WEBHOOK_SECRET=
# Paystack live rail (blank -> safe local stub; set to use the real API)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE=https://api.paystack.co

# --- Notification gateways (blank -> console stub) ---
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@yourdomain.co.za
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- E-sign (set ESIGN_API_URL to use a real REST provider, else native stub) ---
ESIGN_API_URL=
ESIGN_API_KEY=
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
PAYSTACK_SECRET_KEY=

# --- Auth (JWT + passwordless OTP) ---
# --- PII / banking encryption (POPIA) ---
# Secret used to derive the AES-256-GCM key that encrypts owner banking details
# at rest. MUST be set (and kept stable + secret) in production; if it changes,
# previously-encrypted values become unreadable. Blank = insecure dev key.
PII_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API. REQUIRED in production.
CORS_ORIGINS=http://localhost:3001
# Wrong OTP guesses before the challenge is burned
OTP_MAX_ATTEMPTS=5

JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=1h
# OTP lifetime. The email copy derives its wording from this at runtime
# ("expires in 5 minutes"), but the WhatsApp authentication template has a FIXED
# expiry warning baked in when Meta approves it. If you change this, re-submit
# the WhatsApp template too or it will state the wrong number.
OTP_TTL_SECONDS=300
OTP_CHANNEL=console

# --- Dunning ---
LATE_FEE_PCT=0.10

# --- Webhook signature secrets (HMAC-SHA256 over raw body; blank = dev bypass) ---
STITCH_WEBHOOK_SECRET=
ESIGN_WEBHOOK_SECRET=

# --- Default market policy profile ---
DEFAULT_TAX_PROFILE=ZA_VAT
DEFAULT_DEPOSIT_POLICY=ZA_RHA
DEFAULT_PRACTITIONER_COMPLIANCE=ZA_PPRA
