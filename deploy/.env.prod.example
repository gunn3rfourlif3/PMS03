# ── PMS 0.3 production env (Contabo VPS) ──────────────────────────────────────
# Copy to deploy/.env.prod and fill in. NEVER commit the filled file.
# Generate the two secrets with:  openssl rand -hex 32

# Domains (must match your DNS A records -> 169.58.46.223 and the Caddyfile).
# CORS_ORIGINS is a comma-separated allowlist — include every front-end origin
# that calls the API (web back-office + the tenant & landlord apps).
CORS_ORIGINS=https://app.dantalan.co.za,https://tenant.dantalan.co.za,https://landlord.dantalan.co.za,https://rentals.dantalan.co.za,https://www.dantalan.co.za,https://dantalan.co.za
NEXT_PUBLIC_API_BASE=https://api.dantalan.co.za/api
# Server-side public base for URLs the API hands out to browsers and mail
# clients: uploaded media, and the fallback logo mark in email headers. Unset,
# media URLs come out relative and branded email falls back to a plain wordmark.
PUBLIC_API_BASE=https://api.dantalan.co.za/api

# Datastore
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Security (REQUIRED — app refuses to boot in prod without these)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
PII_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32   # keep stable & secret forever

# Idle auto-logout. Access tokens live for this many minutes and are refreshed on
# user activity; an idle session past this window expires and is rejected by the
# API. Keep the front-ends' build-time NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES /
# EXPO_PUBLIC_IDLE_TIMEOUT_MINUTES in sync with this (all default to 10).
SESSION_IDLE_MINUTES=10

# Partner programme (software resellers).
# Comma-separated emails that log in as the PLATFORM ADMIN (you) — manages
# partners, subscriptions, and commission payouts.
PLATFORM_ADMIN_EMAILS=
# Commission + pricing config (defaults shown). Growth bills ALL units over the
# free threshold at the per-unit price.
PARTNER_DEFAULT_RATE=0.10
GROWTH_PRICE_PER_UNIT=250
FREE_UNIT_THRESHOLD=10
# Base URL used in a partner's referral signup link.
PARTNER_SIGNUP_BASE=https://app.dantalan.co.za
# Minimum partner payout in rands; smaller balances roll over, and the payout
# run releases everything regardless in Mar/Jun/Sep/Dec. See
# docs/LOCARE_COMMISSION_STRUCTURE.md §4.1.
PARTNER_PAYOUT_FLOOR=250
# Cap on simultaneously open, unconverted prospects per partner (§7). Stops a
# partner reserving a whole market they have done no work on.
PARTNER_OPEN_LEAD_CAP=20

# --- Stitch (pay-by-bank, refunds, disbursements) ---
# Off by default: without STITCH_LIVE the provider stubs and makes no network
# calls, so deploying these blank changes nothing. See .env.example for the full
# annotated set.
STITCH_LIVE=false
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# Svix signing secret (whsec_...). The ONLY thing that can mark a Stitch payment
# paid — the browser redirect's status is not trusted.
STITCH_WEBHOOK_SECRET=
# Must be on a domain Stitch has allowlisted, https in production.
STITCH_REDIRECT_URI=https://app.locare.co.za/pay/return
STITCH_CONFIRM_ON=received

# One-time-password delivery (prod cannot use the console channel).
# The channel is chosen automatically from the destination: an email address is
# sent via SendGrid; a phone number is sent via Twilio SMS. OTP_CHANNEL just
# switches real delivery on — keep it as any non-'console' value (e.g. 'email').
OTP_CHANNEL=email
# OTP lifetime (seconds; defaults to 300 = 5 min). The email copy derives its
# wording from this at runtime, but the WhatsApp authentication template carries a
# FIXED expiry warning set when Meta approves it — change this and you must
# re-submit the template, or WhatsApp will quote the wrong number.
OTP_TTL_SECONDS=300
TRUSTED_DEVICE_DAYS=30       # "remember this device" lifetime; 0 disables (returning users skip OTP)
# Ordered delivery cascade (WhatsApp primary, email fallback). WhatsApp is used
# only once WHATSAPP_TOKEN is set + templates are approved; until then, email-only.
OTP_CHANNELS=whatsapp,email
WELCOME_CHANNELS=            # optional; defaults to OTP_CHANNELS
TENANT_APP_URL=https://app.locare.co.za
# WhatsApp Cloud API (Meta, direct). See docs/LOCARE_WHATSAPP_ONBOARDING_DESIGN.md §8.
WHATSAPP_TOKEN=             # permanent access token (system user)
WHATSAPP_PHONE_ID=         # sender phone-number ID
WHATSAPP_OTP_TEMPLATE=locare_otp        # approved authentication template (needs a Copy-code button)
WHATSAPP_WELCOME_TEMPLATE=locare_welcome # approved utility template
WHATSAPP_TEMPLATE_LANG=en   # must match the template's language EXACTLY ('en' != 'en_US')
# Email delivery: if SMTP_HOST is set it is used (recommended when the mailbox is
# hosted with the same provider, e.g. HostAfrica); otherwise SendGrid; otherwise
# a console stub. Fill ONE of the two blocks below.
SMTP_HOST=            # e.g. mail.locare.co.za (from HostAfrica → Email → mail client settings)
SMTP_PORT=587         # 587 STARTTLS (recommended) or 465 implicit TLS
SMTP_SECURE=          # leave blank; set true only for port 465
SMTP_USER=            # full mailbox address, e.g. partners@locare.co.za
SMTP_PASS=            # that mailbox's password
SMTP_FROM=partners@locare.co.za   # sender shown on the email
SENDGRID_API_KEY=
SENDGRID_FROM=pms@dantalan.co.za
# SMS OTP (Twilio) — fill these in to enable mobile-number login:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=          # Twilio sender in E.164, e.g. +27600000000 (or an approved alphanumeric sender ID)

# Marketing site lead notifications — where demo/contact/chatbot form
# submissions are emailed. Leave blank to only store leads in the DB (they are
# always written to `leads` first, so a broken mail path loses nothing).
# Must be a mailbox that EXISTS on a domain with MX: the API checks MX at boot
# and logs the result, but a valid domain with no such mailbox still bounces
# silently. Submit the form once after changing it.
LEADS_NOTIFY_EMAIL=hello@locare.co.za

# Automatic acknowledgement to the person who submitted the form (demo /
# contact / chatbot only — partner registrations have their own emails).
# LEADS_ACK_FROM must be a real mailbox or alias the SMTP account is permitted
# to send as; a From on another domain will be refused by the relay and will
# fail SPF/DKIM alignment even if it isn't. Blank ⇒ sends as SMTP_FROM.
LEADS_ACK_FROM=daniel@locare.co.za
LEADS_ACK_FROM_NAME=Daniel
# Blank ⇒ replies go to LEADS_ACK_FROM. Keep comments on their own line:
# Compose does not strip a trailing comment on an unquoted value in every
# version, and a stray '#' landing in a Reply-To header fails the whole send.
LEADS_ACK_REPLY_TO=
LEADS_ACK_DEMO_URL=https://locare.co.za/demo
# Images in the acknowledgement. Both must be https PNG/JPG/GIF on a public
# host — Gmail and Outlook drop SVG and block http:// — or they are omitted and
# the email still reads correctly without them.
LEADS_ACK_POSTER_URL=https://locare.co.za/demo/poster.jpg
LEADS_ACK_LOGO_URL=https://locare.co.za/brand/locare-logo-email-white.png
# Set to 'off' to disable acknowledgements.
LEADS_ACK=

# Tenant app URL included in the "application approved" message sent to tenants.
TENANT_APP_URL=https://tenant.dantalan.co.za

# Base URL for lease e-signing links (the back-office web origin).
SIGN_BASE=https://app.dantalan.co.za

# Smart lease parsing (AI). 'heuristic' works with no key (regex, lower accuracy).
# Set 'anthropic' + an API key for LLM-grade extraction.
DOCUMENT_AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
DOCUMENT_AI_MODEL=            # blank → claude-3-5-sonnet-latest
DOCUMENT_AI_TIMEOUT_MS=45000 # per-attempt timeout
DOCUMENT_AI_MAX_RETRIES=2    # extra attempts on transient 429/5xx/overload

# Payments — first deploy uses iKhokha only. All other rails stay stubbed.
PAYMENT_PROVIDER=ikhokha
PAYOUT_PROVIDER=paystack          # payout stubbed (manual EFT) unless PAYSTACK_LIVE=true
IKHOKHA_APP_ID=              # Application Key ID (from the iKhokha dashboard)
IKHOKHA_APP_SECRET=          # Application Key Secret — put the REAL value only in deploy/.env.prod
IKHOKHA_ENTITY_ID=
IKHOKHA_MODE=live
IKHOKHA_CALLBACK_URL=https://api.dantalan.co.za/api/payments/webhook/ikhokha
# Signature check on inbound callbacks: off | monitor | enforce. Start on 'monitor'
# (verifies + logs, still processes), confirm "IK-SIGN verified" in the api logs on a
# real callback, then switch to 'enforce'. Requires IKHOKHA_CALLBACK_URL + IKHOKHA_APP_SECRET.
IKHOKHA_VERIFY_CALLBACK=monitor
IKHOKHA_SUCCESS_URL=https://app.dantalan.co.za/pay/success
IKHOKHA_FAIL_URL=https://app.dantalan.co.za/pay/failed
IKHOKHA_CANCEL_URL=https://app.dantalan.co.za/pay/cancelled

# --- Error tracking (optional) ---
# Unset, errors log locally and nothing is sent anywhere. When set,
# 5xx responses are reported with PII scrubbed in our code first
# (src/common/observability/scrub.ts) — POPIA applies to crash reports.
# Needs: npm install @sentry/node, plus a DPA with Sentry and a line in
# the privacy policy naming them as a processor.
SENTRY_DSN=
APP_RELEASE=
