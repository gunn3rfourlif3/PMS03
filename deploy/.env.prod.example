# ── PMS 0.3 production env (Contabo VPS) ──────────────────────────────────────
# Copy to deploy/.env.prod and fill in. NEVER commit the filled file.
# Generate the two secrets with:  openssl rand -hex 32

# Domains (must match your DNS A records -> 169.58.46.223 and the Caddyfile).
# CORS_ORIGINS is a comma-separated allowlist — include every front-end origin
# that calls the API (web back-office + the tenant & landlord apps).
CORS_ORIGINS=https://app.dantalan.co.za,https://tenant.dantalan.co.za,https://landlord.dantalan.co.za,https://rentals.dantalan.co.za,https://www.dantalan.co.za
NEXT_PUBLIC_API_BASE=https://api.dantalan.co.za/api

# Datastore
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Security (REQUIRED — app refuses to boot in prod without these)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
PII_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32   # keep stable & secret forever

# One-time-password delivery (prod cannot use the console channel).
# The channel is chosen automatically from the destination: an email address is
# sent via SendGrid; a phone number is sent via Twilio SMS. OTP_CHANNEL just
# switches real delivery on — keep it as any non-'console' value (e.g. 'email').
OTP_CHANNEL=email
SENDGRID_API_KEY=
SENDGRID_FROM=pms@dantalan.co.za
# SMS OTP (Twilio) — fill these in to enable mobile-number login:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=          # Twilio sender in E.164, e.g. +27600000000 (or an approved alphanumeric sender ID)

# Marketing site lead notifications — where agent/demo/contact form submissions
# are emailed (via SendGrid). Leave blank to only store leads in the DB.
LEADS_NOTIFY_EMAIL=

# Tenant app URL included in the "application approved" message sent to tenants.
TENANT_APP_URL=https://tenant.dantalan.co.za

# Base URL for lease e-signing links (the back-office web origin).
SIGN_BASE=https://app.dantalan.co.za

# Smart lease parsing (AI). 'heuristic' works with no key (regex, lower accuracy).
# Set 'anthropic' + an API key for LLM-grade extraction.
DOCUMENT_AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
DOCUMENT_AI_MODEL=

# Payments — first deploy uses iKhokha only. All other rails stay stubbed.
PAYMENT_PROVIDER=ikhokha
PAYOUT_PROVIDER=paystack          # payout stubbed (manual EFT) unless PAYSTACK_LIVE=true
IKHOKHA_APP_ID=              # Application Key ID (from the iKhokha dashboard)
IKHOKHA_APP_SECRET=          # Application Key Secret — put the REAL value only in deploy/.env.prod
IKHOKHA_ENTITY_ID=
IKHOKHA_MODE=live
IKHOKHA_CALLBACK_URL=https://api.dantalan.co.za/api/payments/webhook/ikhokha
IKHOKHA_SUCCESS_URL=https://app.dantalan.co.za/pay/success
IKHOKHA_FAIL_URL=https://app.dantalan.co.za/pay/failed
IKHOKHA_CANCEL_URL=https://app.dantalan.co.za/pay/cancelled