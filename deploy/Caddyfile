# Reverse proxy with automatic HTTPS (Let's Encrypt).
# Replace the two hostnames and the email, then Caddy handles TLS certs for you.
# DNS: create A records  app / api / tenant / landlord / rentals / www .dantalan.co.za  ->  169.58.46.223
#      and an apex A record   @ (dantalan.co.za)  ->  169.58.46.223
#      (and AAAA -> 2a02:c207:2345:3343::1 if you want IPv6).

{
	email admin@dantalan.co.za
}

# Web back-office (Next.js)
app.dantalan.co.za {
	encode zstd gzip
	@assets path /_next/static/* /brand/*
	handle @assets {
		reverse_proxy web:3001
	}
	handle {
		reverse_proxy web:3001 {
			header_down Cache-Control "no-cache"
		}
	}
}

# API (NestJS). CORS is enforced by the app via CORS_ORIGINS.
api.dantalan.co.za {
	encode zstd gzip
	reverse_proxy api:3000
}

# Tenant app (Expo web export)
tenant.dantalan.co.za {
	encode zstd gzip
	reverse_proxy tenant:80
}

# Landlord app (Expo web export)
landlord.dantalan.co.za {
	encode zstd gzip
	reverse_proxy landlord:80
}

# Public rentals site (served by the Next.js web container; public routes only)
rentals.dantalan.co.za {
	encode zstd gzip
	reverse_proxy web:3001
}

# Public rentals site on the apex + www. The site root redirects to the
# rentals index (the Next.js web container serves it). Other paths (/l/<id>,
# /login, /apply, …) proxy straight through.
dantalan.co.za, www.dantalan.co.za {
	encode zstd gzip
	redir / /rentals
	reverse_proxy web:3001
}

# ── Locare (platform brand) ──────────────────────────────────────────────
# DNS: A records  @ (locare.co.za) / www / api .locare.co.za  ->  169.58.46.223
# (These are exact hostnames, so Caddy issues certs via HTTP-01 — no DNS
#  plugin needed. The *.locare.co.za wildcard for agencies comes later.)

# Locare marketing + agency signup (static site)
locare.co.za, www.locare.co.za {
	encode zstd gzip
	reverse_proxy marketing:80
}

# Locare back-office (same Next.js web container; resolves the user's role +
# agency at login). Branding falls back to default until the platform-brand
# layer lands (Locare Phase 0).
app.locare.co.za {
	encode zstd gzip
	# Immutable hashed assets keep Next's long-lived caching.
	@assets path /_next/static/* /brand/*
	handle @assets {
		reverse_proxy web:3001
	}
	# HTML documents must always revalidate so a new deploy (new chunk hashes) is
	# picked up immediately, instead of a browser replaying a stale page that
	# points at old JS. header_down forces this on the proxied response itself —
	# a plain `header ... defer` doesn't beat Next's prerendered s-maxage.
	handle {
		reverse_proxy web:3001 {
			header_down Cache-Control "no-cache"
		}
	}
}

# Locare API (same NestJS container; CORS enforced via CORS_ORIGINS)
api.locare.co.za {
	encode zstd gzip
	reverse_proxy api:3000
}
