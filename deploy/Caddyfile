# Reverse proxy with automatic HTTPS (Let's Encrypt).
#
# ⚠ THIS FILE IS THE SOURCE OF TRUTH. Edit it here and deploy with `git pull`,
# never directly on the VPS. Blocks added on the server in 2026 (BuddhaPets,
# tenant./landlord.locare.co.za) were invisible to the repo for weeks, and a
# `git checkout` of this file would have taken a live site down. If a change is
# urgent enough to make on the box, commit it the same day.
# Replace the two hostnames and the email, then Caddy handles TLS certs for you.
# DNS: create A records  app / api / tenant / landlord / rentals / www .dantalan.co.za  ->  169.58.46.223
#      and an apex A record   @ (dantalan.co.za)  ->  169.58.46.223
#      (and AAAA -> 2a02:c207:2345:3343::1 if you want IPv6).

{
	email admin@dantalan.co.za

	# On-demand TLS: certificates for agency domains are issued during the
	# first handshake, but ONLY for hosts the API vouches for — an active
	# vendor's custom_domain, or the platform's own hosts. Without the `ask`
	# endpoint, anyone pointing a domain at this IP would get a certificate
	# issued in Locare's name and burn our Let's Encrypt budget.
	#
	# The endpoint answers 200 (issue) or 404 (refuse) and nothing else.
	#
	# `ask` is the ONLY control here: Caddy removed the built-in interval/burst
	# rate limiter, and setting either now refuses to start the server. So the
	# endpoint's deny-by-default behaviour is not defence in depth, it is the
	# whole defence. See docs/LOCARE_ONDEMAND_TLS_DESIGN.md.
	on_demand_tls {
		ask http://api:3000/api/public/tls-check
	}
}

# Web back-office (Next.js)
app.dantalan.co.za {
	encode zstd gzip
	# Same-origin API. NEXT_PUBLIC_API_BASE is baked into the web bundle at build
	# time and one image serves every brand, so an absolute host there sent every
	# brand's browser to whichever one was compiled in. With the API on each app
	# origin the bundle needs no hostname, and CORS stops governing first-party
	# calls. Every host that serves web:3001 needs this route — a host without it
	# has a console that cannot reach the API at all.
	handle /api/* {
		reverse_proxy api:3000
	}
	@assets path /_next/static/* /brand/*
	handle @assets {
		reverse_proxy web:3001
	}
	handle {
		reverse_proxy web:3001 {
			header_down Cache-Control "no-cache"
		}
	}
}

# API (NestJS). CORS is enforced by the app via CORS_ORIGINS.
api.dantalan.co.za {
	encode zstd gzip
	reverse_proxy api:3000
}

# Tenant app (Expo web export)
tenant.dantalan.co.za {
	encode zstd gzip
	reverse_proxy tenant:80
}

# Landlord app (Expo web export)
landlord.dantalan.co.za {
	encode zstd gzip
	reverse_proxy landlord:80
}

# Public rentals site (served by the Next.js web container; public routes only)
rentals.dantalan.co.za {
	encode zstd gzip
	# Same-origin API. NEXT_PUBLIC_API_BASE is baked into the web bundle at build
	# time and one image serves every brand, so an absolute host there sent every
	# brand's browser to whichever one was compiled in. With the API on each app
	# origin the bundle needs no hostname, and CORS stops governing first-party
	# calls. Every host that serves web:3001 needs this route — a host without it
	# has a console that cannot reach the API at all.
	handle /api/* {
		reverse_proxy api:3000
	}
	reverse_proxy web:3001
}

# Public rentals site on the apex + www. The site root redirects to the
# rentals index (the Next.js web container serves it). Other paths (/l/<id>,
# /login, /apply, …) proxy straight through.
dantalan.co.za, www.dantalan.co.za {
	encode zstd gzip
	# Same-origin API. NEXT_PUBLIC_API_BASE is baked into the web bundle at build
	# time and one image serves every brand, so an absolute host there sent every
	# brand's browser to whichever one was compiled in. With the API on each app
	# origin the bundle needs no hostname, and CORS stops governing first-party
	# calls. Every host that serves web:3001 needs this route — a host without it
	# has a console that cannot reach the API at all.
	handle /api/* {
		reverse_proxy api:3000
	}
	redir / /rentals
	reverse_proxy web:3001
}

# ── Locare (platform brand) ──────────────────────────────────────────────
# DNS: A records  @ (locare.co.za) / www / api .locare.co.za  ->  169.58.46.223
# (These are exact hostnames, so Caddy issues certs via HTTP-01 — no DNS
#  plugin needed. The *.locare.co.za wildcard for agencies comes later.)

# Locare marketing + agency signup (static site)
locare.co.za, www.locare.co.za {
	# Text only — see marketing/web.Caddyfile. Compressing the demo MP4 at this
	# layer would defeat byte-range requests just the same.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy marketing:80
}

# Locare back-office (same Next.js web container; resolves the user's role +
# agency at login). Branding falls back to default until the platform-brand
# layer lands (Locare Phase 0).
app.locare.co.za {
	encode zstd gzip
	# Same-origin API. NEXT_PUBLIC_API_BASE is baked into the web bundle at build
	# time and one image serves every brand, so an absolute host there sent every
	# brand's browser to whichever one was compiled in. With the API on each app
	# origin the bundle needs no hostname, and CORS stops governing first-party
	# calls. Every host that serves web:3001 needs this route — a host without it
	# has a console that cannot reach the API at all.
	handle /api/* {
		reverse_proxy api:3000
	}
	# Immutable hashed assets keep Next's long-lived caching.
	@assets path /_next/static/* /brand/*
	handle @assets {
		reverse_proxy web:3001
	}
	# HTML documents must always revalidate so a new deploy (new chunk hashes) is
	# picked up immediately, instead of a browser replaying a stale page that
	# points at old JS. header_down forces this on the proxied response itself —
	# a plain `header ... defer` doesn't beat Next's prerendered s-maxage.
	handle {
		reverse_proxy web:3001 {
			header_down Cache-Control "no-cache"
		}
	}
}

# Locare API (same NestJS container; CORS enforced via CORS_ORIGINS)
api.locare.co.za {
	encode zstd gzip
	reverse_proxy api:3000
}

# ── Locare demo stack (prospect demos) ───────────────────────────────────
# A second, complete copy of the product on its own database, served by the
# `demo` compose project (deploy/demo/compose.demo.yml) over this same network.
#
# Explicit hostnames, so they beat the on-demand `^app\.` catch-all further
# down — without these blocks app.demo.locare.co.za is served by PRODUCTION.
#
# Locked down on purpose. These hosts carry a named prospect's branding and
# invented tenant records; neither should be found by a search engine or opened
# by a stranger. basic_auth covers every path, and the X-Robots-Tag is belt and
# braces for anything that follows a link.
#
# The bcrypt hash below is generated with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
(demo_guard) {
	basic_auth {
		{$DEMO_USER} {$DEMO_PASSWORD_HASH}
	}
	header X-Robots-Tag "noindex, nofollow, noarchive"
}

app.demo.locare.co.za {
	encode zstd gzip
	import demo_guard
	handle /api/* {
		reverse_proxy demo-api:3000
	}
	@assets path /_next/static/* /brand/*
	handle @assets {
		reverse_proxy demo-web:3001
	}
	handle {
		reverse_proxy demo-web:3001 {
			header_down Cache-Control "no-cache"
		}
	}
}

api.demo.locare.co.za {
	encode zstd gzip
	import demo_guard
	reverse_proxy demo-api:3000
}

tenant.demo.locare.co.za {
	encode zstd gzip
	import demo_guard
	reverse_proxy demo-tenant:80
}

landlord.demo.locare.co.za {
	encode zstd gzip
	import demo_guard
	reverse_proxy demo-landlord:80
}

# Every message the demo stack sends. Shown on screen during a demo, so it is
# behind the same guard as everything else.
mail.demo.locare.co.za {
	encode zstd gzip
	import demo_guard
	reverse_proxy demo-mailpit:8025
}

