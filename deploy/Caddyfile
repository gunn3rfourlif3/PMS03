# Reverse proxy with automatic HTTPS (Let's Encrypt).
# Replace the two hostnames and the email, then Caddy handles TLS certs for you.
# DNS: create A records  app / api / tenant / landlord / rentals / www .dantalan.co.za  ->  169.58.46.223
#      (and AAAA -> 2a02:c207:2345:3343::1 if you want IPv6).

{
	email admin@dantalan.co.za
}

# Web back-office (Next.js)
app.dantalan.co.za {
	encode zstd gzip
	reverse_proxy web:3001
}

# API (NestJS). CORS is enforced by the app via CORS_ORIGINS.
api.dantalan.co.za {
	encode zstd gzip
	reverse_proxy api:3000
}

# Tenant app (Expo web export)
tenant.dantalan.co.za {
	encode zstd gzip
	reverse_proxy tenant:80
}

# Landlord app (Expo web export)
landlord.dantalan.co.za {
	encode zstd gzip
	reverse_proxy landlord:80
}

# Public rentals site (served by the Next.js web container; public routes only)
rentals.dantalan.co.za {
	encode zstd gzip
	reverse_proxy web:3001
}

# Marketing / product site (static). Swap this hostname for the product's own
# domain when you have one (e.g. www.getkaya.co.za) and update DNS + CORS.
www.dantalan.co.za {
	encode zstd gzip
	reverse_proxy marketing:80
}
