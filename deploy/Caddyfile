# Reverse proxy with automatic HTTPS (Let's Encrypt).
#
# ⚠ THIS FILE IS THE SOURCE OF TRUTH. Edit it here and deploy with `git pull`,
# never directly on the VPS. Blocks added on the server in 2026 (BuddhaPets,
# tenant./landlord.locare.co.za) were invisible to the repo for weeks, and a
# `git checkout` of this file would have taken a live site down. If a change is
# urgent enough to make on the box, commit it the same day.
# Replace the two hostnames and the email, then Caddy handles TLS certs for you.
# DNS: create A records  app / api / tenant / landlord / rentals / www .dantalan.co.za  ->  169.58.46.223
#      and an apex A record   @ (dantalan.co.za)  ->  169.58.46.223
#      (and AAAA -> 2a02:c207:2345:3343::1 if you want IPv6).

{
	email admin@dantalan.co.za

	# On-demand TLS: certificates for agency domains are issued during the
	# first handshake, but ONLY for hosts the API vouches for — an active
	# vendor's custom_domain, or the platform's own hosts. Without the `ask`
	# endpoint, anyone pointing a domain at this IP would get a certificate
	# issued in Locare's name and burn our Let's Encrypt budget.
	#
	# The endpoint answers 200 (issue) or 404 (refuse) and nothing else.
	#
	# `ask` is the ONLY control here: Caddy removed the built-in interval/burst
	# rate limiter, and setting either now refuses to start the server. So the
	# endpoint's deny-by-default behaviour is not defence in depth, it is the
	# whole defence. See docs/LOCARE_ONDEMAND_TLS_DESIGN.md.
	on_demand_tls {
		ask http://api:3000/api/public/tls-check
	}
}

# Web back-office (Next.js)
app.dantalan.co.za {
	encode zstd gzip
	@assets path /_next/static/* /brand/*
	handle @assets {
		reverse_proxy web:3001
	}
	handle {
		reverse_proxy web:3001 {
			header_down Cache-Control "no-cache"
		}
	}
}

# API (NestJS). CORS is enforced by the app via CORS_ORIGINS.
api.dantalan.co.za {
	encode zstd gzip
	reverse_proxy api:3000
}

# Tenant app (Expo web export)
tenant.dantalan.co.za {
	encode zstd gzip
	reverse_proxy tenant:80
}

# Landlord app (Expo web export)
landlord.dantalan.co.za {
	encode zstd gzip
	reverse_proxy landlord:80
}

# Public rentals site (served by the Next.js web container; public routes only)
rentals.dantalan.co.za {
	encode zstd gzip
	reverse_proxy web:3001
}

# Public rentals site on the apex + www. The site root redirects to the
# rentals index (the Next.js web container serves it). Other paths (/l/<id>,
# /login, /apply, …) proxy straight through.
dantalan.co.za, www.dantalan.co.za {
	encode zstd gzip
	redir / /rentals
	reverse_proxy web:3001
}

# ── Locare (platform brand) ──────────────────────────────────────────────
# DNS: A records  @ (locare.co.za) / www / api .locare.co.za  ->  169.58.46.223
# (These are exact hostnames, so Caddy issues certs via HTTP-01 — no DNS
#  plugin needed. The *.locare.co.za wildcard for agencies comes later.)

# Locare marketing + agency signup (static site)
locare.co.za, www.locare.co.za {
	# Text only — see marketing/web.Caddyfile. Compressing the demo MP4 at this
	# layer would defeat byte-range requests just the same.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy marketing:80
}

# Locare back-office (same Next.js web container; resolves the user's role +
# agency at login). Branding falls back to default until the platform-brand
# layer lands (Locare Phase 0).
app.locare.co.za {
	encode zstd gzip
	# Immutable hashed assets keep Next's long-lived caching.
	@assets path /_next/static/* /brand/*
	handle @assets {
		reverse_proxy web:3001
	}
	# HTML documents must always revalidate so a new deploy (new chunk hashes) is
	# picked up immediately, instead of a browser replaying a stale page that
	# points at old JS. header_down forces this on the proxied response itself —
	# a plain `header ... defer` doesn't beat Next's prerendered s-maxage.
	handle {
		reverse_proxy web:3001 {
			header_down Cache-Control "no-cache"
		}
	}
}

# Locare API (same NestJS container; CORS enforced via CORS_ORIGINS)
api.locare.co.za {
	encode zstd gzip
	reverse_proxy api:3000
}

# ── Locare app surfaces on the platform domain ───────────────────────────
# Same Expo web export containers as the agency hosts. These have no DNS A
# record yet, so they resolve nowhere — the blocks are ready for when they do.

# Locare tenant app (same Expo web export container as dantalan)
tenant.locare.co.za {
	encode zstd gzip
	reverse_proxy tenant:80
}

# Locare landlord app (same Expo web export container as dantalan)
landlord.locare.co.za {
	encode zstd gzip
	reverse_proxy landlord:80
}

# ── BuddhaPets ───────────────────────────────────────────────────────────
# A separate project sharing this box and this Caddy. Nothing below belongs to
# Locare; it is here because one Caddy fronts the whole VPS.
#
# DNS: A records  cms / @ / www .buddhapets.co.za  ->  169.58.46.223
#
# `buddhapets-wp` and `buddhapets-web` are network aliases set in the
# buddhapets compose project; they resolve over deploy_default, the same
# network this Caddy is on.

# WooCommerce engine + wp-admin (headless: the storefront reads its REST API)
cms.buddhapets.co.za {
	encode zstd gzip
	reverse_proxy buddhapets-wp:80

	# wp-admin, login and the REST API must never be cached anywhere upstream.
	@dynamic path /wp-admin/* /wp-json/* /wp-login.php /wp-cron.php
	header @dynamic Cache-Control "no-store"

	# xmlrpc is the single most brute-forced endpoint in WordPress and this
	# install has no use for it.
	@xmlrpc path /xmlrpc.php
	respond @xmlrpc 403
}

# BuddhaPets storefront (Next.js)
buddhapets.co.za, www.buddhapets.co.za {
	encode zstd gzip
	@assets path /_next/static/* /images/*
	handle @assets {
		reverse_proxy buddhapets-web:3000
	}
	handle {
		reverse_proxy buddhapets-web:3000 {
			header_down Cache-Control "no-cache"
		}
	}
}

# ── Agency domains, certificated on demand ───────────────────────────────
# Everything above is an exact hostname, and Caddy matches the most specific
# site address first — so these blocks keep their own config and their existing
# certificates, and nothing here can change how they behave. This block only
# ever sees hosts nothing above matched, which makes it additive and makes
# rollback "delete this block and restart".
#
# Adding an agency is therefore: set vendors.custom_domain, point DNS here.
# No Caddyfile edit, no restart, no SSH.

# Port 80 for those same hosts: send them to HTTPS rather than 404. Caddy
# serves ACME HTTP-01 challenges ahead of site routes, so this does not
# interfere with issuance — verify that on the throwaway domain in step 4.
http:// {
	redir https://{host}{uri} permanent
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# Caddy's `host` matcher treats * as exactly one label, so `app.*` would NOT
	# match app.agency.co.za. Match the Host header by regex instead.
	@app header_regexp host Host ^app\.
	handle @app {
		@assets path /_next/static/* /brand/*
		handle @assets {
			reverse_proxy web:3001
		}
		# Identical to the explicit agency blocks: Next sets its own
		# Cache-Control and a plain `header` directive loses to it, which is how
		# a deploy appears to half-break for anyone holding a stale page.
		handle {
			reverse_proxy web:3001 {
				header_down Cache-Control "no-cache"
			}
		}
	}

	@api header_regexp host Host ^api\.
	handle @api {
		reverse_proxy api:3000
	}

	@tenant header_regexp host Host ^tenant\.
	handle @tenant {
		reverse_proxy tenant:80
	}

	@landlord header_regexp host Host ^landlord\.
	handle @landlord {
		reverse_proxy landlord:80
	}

	# Apex, www and rentals. all serve the public rentals site.
	handle {
		redir / /rentals
		reverse_proxy web:3001
	}
}
