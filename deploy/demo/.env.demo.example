# Demo stack secrets. Copy to deploy/demo/.env.demo and fill in.
#
#   cp deploy/demo/.env.demo.example deploy/demo/.env.demo
#   openssl rand -hex 32   # -> JWT_SECRET
#   openssl rand -hex 32   # -> PII_ENCRYPTION_KEY
#   openssl rand -hex 16   # -> POSTGRES_PASSWORD
#
# These are DELIBERATELY different from production's. The demo database holds
# invented data and its hosts are reachable from the internet behind nothing but
# basic auth; sharing a JWT secret with production would mean a token minted
# here is accepted there.

POSTGRES_PASSWORD=
JWT_SECRET=
PII_ENCRYPTION_KEY=

# Every origin the demo apps are served from.
CORS_ORIGINS=https://app.demo.locare.co.za,https://tenant.demo.locare.co.za,https://landlord.demo.locare.co.za

# Whoever runs the demo. These addresses get platform_admin in the demo stack.
PLATFORM_ADMIN_EMAILS=

# Per-unit rate for the Custom tier, in cents. Set this when the prospect's
# portfolio is past GROWTH_MAX_UNITS and the conversation is a rate rather than
# a package — which is the case for anyone over 499 units.
CUSTOM_UNIT_RATE=

# Shown as the sender name on demo mail. Defaults to Locare.
BRAND_NAME=

PLATFORM_IP=169.58.46.223
