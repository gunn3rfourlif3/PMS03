# Midnight Masquerade — deployment configuration
#
# WHY THIS FILE EXISTS. Nothing about this client is in the code. There is no
# Midnight Masquerade branch, no fork, and no reference to them anywhere in
# src/, web-admin/ or shared/ — deliberately, because the product is
# white-label and a per-client code path is the thing the capability system was
# built to avoid. What makes an installation theirs is the settings below plus
# the seeded profile, and until now those lived only in gitignored .env files on
# one laptop. If that machine died, this configuration died with it.
#
# NO SECRETS HERE. Every value below is a behavioural setting, safe to commit.
# Secrets (JWT_SECRET, DATABASE_URL, S3_*, STITCH_*, PAYSTACK_*) stay out of
# git and are generated per installation — see .env.example for their shape.
#
# TWO FILES, NOT ONE. The API reads .env; the back office reads
# web-admin/.env.local. DEPLOYMENT_PROFILE must be in BOTH and must agree:
# the API enforces the mode and the back office decides what to show, so
# setting one and not the other produces a menu entry the API then refuses.
#
# To verify a machine matches this file:  .\scripts\demo-up.ps1
# Its preflight checks seven of these settings and refuses to start on a
# mismatch, naming the file and key.


# ============================================================
#  .env  —  the API
# ============================================================

# THE MODE. Sealed on-site: staff back office only, nothing published to the
# internet. Sets manualPayments ON and tenant logins, landlord logins, public
# listings, card rent, e-signature and OTP-to-phone all OFF. An invalid value
# refuses to boot rather than falling back, because failing open on this one
# setting would silently expose what it exists to seal.
DEPLOYMENT_PROFILE=onsite_backoffice

# Login codes go to internal mail, not SMS — there is no outbound path on a
# sealed box. SMTP points at the Mailpit container on the same machine.
OTP_CHANNEL=email
OTP_TTL_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@midnightmasquerade.demo
SMTP_FROM_NAME=Midnight Masquerade

# No gateway reaches this installation. PAYMENT_PROVIDER is set because the
# module requires a value; nothing calls out. Rent arrives as cash or EFT and a
# staff member records it by hand — the capability that is true in this mode
# and no other.
PAYMENT_PROVIDER=ikhokha

# Leases print and are signed on paper. Files stay on local disk.
ESIGN_DRIVER=native
STORAGE_DRIVER=local

# What the agreement covers. Shown to the agency on their settings page beside
# their own unit count, and read by NOTHING else — no code blocks, throttles or
# refuses anything on the strength of it. It exists so growth is visible to
# both sides and the renewal conversation starts from a number they can see
# rather than a surprise.
#
# Unset on every subscription deployment, where the licence language does not
# apply and the page shows the portfolio count alone.
LICENCED_UNITS=500

# South African defaults. Unchanged from the platform's, listed so a future
# installation does not have to guess whether they were deliberate.
DEFAULT_TAX_PROFILE=ZA_VAT
DEFAULT_DEPOSIT_POLICY=ZA_RHA
DEFAULT_PRACTITIONER_COMPLIANCE=ZA_PPRA
LATE_FEE_PCT=0.10


# ============================================================
#  web-admin/.env.local  —  the back office
# ============================================================

DEPLOYMENT_PROFILE=onsite_backoffice

# WHOSE BRAND LOCALHOST LOADS, and the subtlest setting here. On localhost
# there is no useful hostname, so brand resolution falls back to this slug. Set
# to the platform domain it would match PLATFORM_DOMAIN, the code would
# conclude this is Locare's own platform rather than an agency, and it would
# never look the vendor up — Locare's colours, no error anywhere.
NEXT_PUBLIC_VENDOR_SLUG=midnight-masquerade

# The dark console theme. Unset means light, which is every production
# container by default, so no live agency gets a repainted back office.
DEPLOYMENT_THEME=dark

# The language switcher. A deployment serves English plus whatever this names
# and nothing else; unset, the switcher has one locale and hides itself.
#
# >> NEVER SET THIS ON THE PUBLIC LOCARE SITE. The zh-Hans catalogue is
# >> unreviewed machine translation held for this client. The gate is the only
# >> thing keeping it off the live product — being in the build is not
# >> permission to serve it.
DEPLOYMENT_LOCALE=zh-Hans

# Renders /demo, the deployment-mode console. Drop it for a production
# installation: it is a demo affordance, not a feature they bought.
DEMO_CONSOLE=1


# ============================================================
#  Not configuration
# ============================================================
#
# The agency itself — properties, units, staff, branding colours, the two app
# logins — is seeded from demo/profiles/midnight-masquerade.json:
#
#   npm run seed:prospect -- midnight-masquerade
#
# Idempotent on the slug, so running it again fills gaps rather than creating a
# second agency.
#
# IF THIS GOES LIVE, revisit before handover:
#   - DEMO_CONSOLE        remove
#   - NODE_ENV            production, not development
#   - SMTP_*              a real mail path, or confirm internal mail is accepted
#   - DEPLOYMENT_LOCALE   keep only if they have signed off the translation
#   - backups             the sealed box has none by default; see docs/GOTCHAS.md
